# apps/api — secrets and public base URL
# Copy to .env and fill in values. Never commit the real .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# single administrator, configured via environment (Section 4 of the assignment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# public URL of this API, used to build agent-prompt/install manifests
API_BASE_URL=https://api.your-domain.com