{
  "name": "ui-injector",
  "version": "1.0.2",
  "description": "Install Tech Inject components into a consumer React + TypeScript project.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ui-injector": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-theme.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify.js",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@tech-inject/db": "workspace:*",
    "@tech-inject/theme": "workspace:*",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
